# Match infra/docker-compose.yml (POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB).
# If you use a different Postgres, set user, password, and database name to match it.
DATABASE_URL=postgresql+psycopg://sports:sports@localhost:5432/sportsnews

# Optional: GET /feed_clusters in-memory cache (seconds, default 45)
# FEED_CACHE_TTL_SECONDS=45

# Optional: per-IP rate limits (requests per minute)
# RATE_LIMIT_PER_MINUTE_FEED=60
# RATE_LIMIT_PER_MINUTE_CLUSTER=120
# RATE_LIMIT_PER_MINUTE_WRITE=30
