# Copy to .env in this directory (infra/) and adjust if needed. Do not commit .env.
#   cp .env.example .env
#
# Docker Compose substitutes variables from this file, BUT your shell env wins first.
# If LLM vars never reach the worker, run: unset ENABLE_LLM_SUMMARY LLM_API_KEY
# (or open a fresh terminal) before: docker compose --profile worker run --rm worker

# --- Postgres (db service) ---
POSTGRES_DB=sportsnews
POSTGRES_USER=sports
POSTGRES_PASSWORD=sports
POSTGRES_PORT=5432

# --- Backend (FastAPI / SQLAlchemy) — host MUST be `db` inside Compose ---
DATABASE_URL=postgresql+psycopg://sports:sports@db:5432/sportsnews

# --- Worker (raw psycopg) — same host `db`, libpq-style URI ---
WORKER_DATABASE_URL=postgresql://sports:sports@db:5432/sportsnews

# --- Worker: optional LLM enrichment (OpenRouter) ---
# Set both to enable real LLM calls when you run the worker (see infra README / docker-compose).
# HTTP 429 "free-models-per-day" means the account hit OpenRouter’s free-tier cap — add pay-as-you-go
# credits on the OpenRouter billing page (a key “$10 limit” alone does not fund the account).
# Prefer openai/gpt-4o-mini for reliable JSON. openai/o4-mini may use reasoning tokens with empty
# ``content``; the worker falls back to ``reasoning`` / ``reasoning_details`` — use high LLM_MAX_TOKENS
# (e.g. 1200+) and LLM_TIMEOUT_SECS (e.g. 60) or enrichment will still fail.
# With credits, drop the :free suffix (e.g. use openai/gpt-4o-mini, not ...:free) so you are not on the free-model pool.
# ENABLE_LLM_SUMMARY=true
# LLM_API_KEY=sk-or-your-openrouter-key
# LLM_PROVIDER=openrouter
# LLM_MODEL=openai/gpt-4o-mini
# Ask OpenRouter for json_object when the model supports it (default on; auto-fallback on HTTP 400).
# LLM_RESPONSE_FORMAT_JSON=true
# LLM_MAX_TOKENS=1200
# LLM_TIMEOUT_SECS=60
# Pause between enrichment requests (free OpenRouter tiers are ~20/min). Example: 3.5
# LLM_ENRICH_SLEEP_SECS=0

# --- Frontend (browser on your machine) ---
# The app runs in the user’s browser, so the API must be reachable from the host.
# Published backend port (default 8000) — NOT the Docker service name `backend`.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional port overrides
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Enable worker profile without passing --profile worker every time (optional):
# COMPOSE_PROFILES=worker
